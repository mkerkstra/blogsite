{
  "name": "blogsite",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "pnpm build:pdf && next build",
    "build:pdf": "tsx scripts/build-resume-pdf.tsx",
    "build:embeddings": "tsx scripts/build-embeddings.ts",
    "build:lab-thumbs": "tsx scripts/build-lab-thumbnails.ts",
    "submit:indexnow": "node scripts/submit-indexnow.mjs",
    "audit:lighthouse": "tsx scripts/audit-lighthouse.ts",
    "start": "next start",
    "lint": "oxfmt --check && oxlint --config oxlintrc.json src/",
    "lint:fix": "oxfmt --write && oxlint --fix --config oxlintrc.json src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.3.1",
    "@react-pdf/renderer": "4.9.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "chrome-launcher": "1.2.2",
    "happy-dom": "20.14.5",
    "lefthook": "2.2.2",
    "lighthouse": "13.5.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "postcss": "^8.5.30",
    "puppeteer-core": "25.14.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "umap-js": "1.4.0",
    "vite": "^8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.6+sha512.7e1ae66a83a9143c118cc1944f37cc4f2b8acddeda4b001cfa78908f6e46e45e15292739ca6c9d026426cc757e9318cc98c5551d6a16c165097b0028ba87b4e6",
