    "ignoredBuiltDependencies": [
      "esbuild",
      "lefthook",
      "onnxruntime-node"
    ],
    "overrides": {
      "protobufjs": "^7.5.6",
      "@protobufjs/utf8": "^1.1.1",
      "postcss": "^8.5.10"
    }
  }
