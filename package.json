{
  "name": "blogsite",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "pnpm build:pdf && next build",
    "build:pdf": "tsx scripts/build-resume-pdf.tsx",
    "build:embeddings": "tsx scripts/build-embeddings.ts",
    "build:lab-thumbs": "tsx scripts/build-lab-thumbnails.ts",
    "submit:indexnow": "node scripts/submit-indexnow.mjs",
    "audit:lighthouse": "tsx scripts/audit-lighthouse.ts",
    "start": "next start",
    "lint": "oxfmt --check && oxlint --config oxlintrc.json src/",
    "lint:fix": "oxfmt --write && oxlint --fix --config oxlintrc.json src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.18",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.23.0",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.2.0",
    "@react-pdf/renderer": "4.5.1",
    "@tailwindcss/postcss": "4.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "25.9.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "chrome-launcher": "1.2.1",
    "happy-dom": "20.10.6",
    "lefthook": "2.1.9",
    "lighthouse": "13.4.0",
    "oxfmt": "0.57.0",
    "oxlint": "1.72.0",
    "postcss": "8.5.16",
    "puppeteer-core": "25.3.0",
    "tailwindcss": "4.3.2",
    "tsx": "4.23.0",
    "typescript": "6.0.3",
    "umap-js": "1.4.0",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "onnxruntime-node",
      "protobufjs"
    ],
    "overrides": {
      "protobufjs": "^7.5.6",
      "@protobufjs/utf8": "^1.1.1",
      "postcss": "^8.5.10"
    }
  }
}
